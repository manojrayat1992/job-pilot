# ============================================================
# AI Job Pilot  — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.

# OpenAI
OPENAI_API_KEY=

# SerpAPI (for job search)
SERPAPI_KEY=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobpilot
DB_USERNAME=jobpilot
DB_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (minimum 256-bit / 32-char secret)
JWT_SECRET=mySuperSecretKeyForJWTTokenSigningThatIsAtLeast256BitsLong

# File Storage
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
